# ============================================================
# Insight — Centralized Git Ignore Rules
# ============================================================

# --- OS & IDE ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# --- Environment & Security ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
! .env.example

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
ENV/
/build/
develop-eggs/
/dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Frontend src/lib (un-ignore, since /lib/ above would block it) ---
!frontend/src/lib/

# --- Node.js ---
node_modules/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Logs & Temp ---
*.log
*.tmp
*.bak
error_trace.txt
out.txt
eslint_output.txt
eslint_utf8.txt


##docs
.claude/
.agent/
.gemini/
docs/

# --- One-time scripts (not for git) ---
scripts/setup-ubuntu.sh