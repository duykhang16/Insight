{
  "venvPath": "backend",
  "venv": "venv",
  "pythonVersion": "3.11",
  "pythonPlatform": "Windows",
  "include": ["backend/app"],
  "exclude": ["**/__pycache__", "frontend", "node_modules"],
  "extraPaths": ["backend"],
  "reportMissingImports": "none",
  "reportMissingModuleSource": "none",
  "reportAttributeAccessIssue": "warning",
  "typeCheckingMode": "off"
}
